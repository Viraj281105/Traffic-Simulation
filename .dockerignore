# Version control
.git
.gitignore

# Python virtual environments & caches
backend/.venv
backend/.mypy_cache
backend/.pytest_cache
backend/.ruff_cache
backend/__pycache__
backend/src/__pycache__
**/__pycache__
**/*.pyc
**/*.pyo

# Database & Local Data files
*.db
backend/*.db
data/

# Frontend dependencies and builds
frontend/node_modules
frontend/dist
frontend/.env.local

# Documentation & internal scripts
docs/
scripts/
.github/
.vscode/

# IDE & OS
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Not used by backend/Dockerfile (the only build using this context): the
# frontend image builds from ./frontend with its own .dockerignore, and
# backend tests never enter the image. Keeping them out means editing them
# neither slows the build context nor invalidates any cache.
frontend/
landingpage/
backend/tests/
*.md
*.ps1
*.csv

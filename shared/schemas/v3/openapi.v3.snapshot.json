{
  "components": {
    "schemas": {
      "CreateTokenRequest": {
        "additionalProperties": false,
        "description": "Request payload for POST /api/v3/tokens.",
        "properties": {
          "expiresInDays": {
            "default": 30,
            "description": "Validity period (default 30d, max 90d)",
            "maximum": 90.0,
            "minimum": 1.0,
            "title": "Expiresindays",
            "type": "integer"
          },
          "name": {
            "description": "Human-readable token name",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "scopes": {
            "description": "Requested permissions",
            "items": {
              "enum": [
                "experiments:read",
                "experiments:run",
                "packages:read",
                "packages:write",
                "tokens:read",
                "tokens:manage"
              ],
              "type": "string"
            },
            "minItems": 1,
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "name",
          "scopes"
        ],
        "title": "CreateTokenRequest",
        "type": "object"
      },
      "ExperimentList": {
        "properties": {
          "experiments": {
            "items": {
              "$ref": "#/components/schemas/ExperimentStatus"
            },
            "title": "Experiments",
            "type": "array"
          },
          "format": {
            "const": "urbanflow-experiment-list",
            "default": "urbanflow-experiment-list",
            "title": "Format",
            "type": "string"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "version": {
            "const": 1,
            "default": 1,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "limit",
          "offset",
          "experiments"
        ],
        "title": "ExperimentList",
        "type": "object"
      },
      "ExperimentStatus": {
        "properties": {
          "counts": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunCounts"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "title": "Createdat",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "format": {
            "const": "urbanflow-experiment-status",
            "default": "urbanflow-experiment-status",
            "title": "Format",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "progress": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Progress"
          },

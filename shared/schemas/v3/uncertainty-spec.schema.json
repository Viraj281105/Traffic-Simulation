{
  "$defs": {
    "Distribution": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "uniform",
            "triangular",
            "truncated_normal",
            "lognormal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "mode": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "mu": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mu"
        },
        "sd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sd"
        },
        "sigma": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sigma"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Distribution",
      "type": "object"
    },
    "Factor": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "default": "assumed",
          "enum": [
            "assumed",
            "observed",
            "user"
          ],
          "title": "Basis",
          "type": "string"
        },
        "bounds": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Bounds",
          "type": "array"
        },
        "distribution": {
          "$ref": "#/$defs/Distribution"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "demand_scale",
            "turning_shift",
            "mix_shift",
            "headway_scale",
            "desired_speed_scale",
            "max_acceleration_scale"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "distribution",
        "bounds"
      ],
      "title": "Factor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conditions": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Conditions",
      "type": "integer"
    },
    "factors": {
      "items": {
        "$ref": "#/$defs/Factor"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Factors",
      "type": "array"
    },
    "format": {
      "const": "urbanflow-uncertainty-spec",
      "default": "urbanflow-uncertainty-spec",
      "title": "Format",
      "type": "string"
    },
    "name": {
      "default": "Uncertainty specification",
      "maxLength": 120,
      "title": "Name",
      "type": "string"
    },
    "primaryIndicator": {
      "default": "averageDelay",
      "enum": [
        "averageDelay",
        "medianDelay",
        "p95Delay"
      ],
      "title": "Primaryindicator",
      "type": "string"
    },
    "replications": {
      "default": 2,
      "maximum": 10,
      "minimum": 1,
      "title": "Replications",
      "type": "integer"
    },
    "seed": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "tieTolerance": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tietolerance"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "factors",
    "conditions",
    "seed"
  ],
  "title": "UncertaintySpec",
  "type": "object"
}

# Traffic Simulation Frontend Environment Configuration
# Copy this file to .env.local and set your backend URL

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000

# Local development auth bypass (dev server only; ignored by `npm run build`).
# The dev server acts as a signed-in local developer until Cognito is
# connected; the backend must run with DEV_AUTH_BYPASS=1 to accept it.
# Set to "false" to test the real Cognito sign-in flow locally.
# VITE_DEV_AUTH_BYPASS=false
